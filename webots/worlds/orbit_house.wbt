# ORBIT house (v0.16): a furnished home for the NAO humanoid. GENERATED by tools/make_house_world.py from orbit_ros/house.py;
# edit house.py and run the tool again instead of editing this file. The NAO's controller is <extern>: start the world with
# .\start_webots.ps1 -Humanoid , then the MCP server (orbit_mcp_server.py --robot nao --sim webots) drives it. Not run by the author.
WorldInfo {
  title "ORBIT house (NAO humanoid, extern controller for the MCP server)"
  basicTimeStep 20
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material2 "NAO foot material"
      coulombFriction [
        7
      ]
      bounce 0.3
      bounceVelocity 0.003
    }
  ]
}
