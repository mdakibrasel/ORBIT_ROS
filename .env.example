# ORBIT-ROS local settings. COPY this file to ".env" and paste your own keys. Never commit or share ".env".
#   PowerShell:  Copy-Item .env.example .env        (setup.ps1 does this for you)
# One key per provider. Do not put one provider's key in another provider's variable.
# The Oracle, World2D and Webots runs need NO key. Keys are only used by live-LLM runs (preflight_llm.py, run_spatial.py --planner ...)
# and by orbit_chat.py (talk to the robot through the MCP server with your own key: python orbit_chat.py --provider gemini).

LLM_PROVIDER_ORDER=gemini,groq        # only used by check_env.py (status display). There is NO automatic provider fallback: choose with run_spatial.py --planner
LLM_REQUEST_TIMEOUT=60                # seconds; used by the Groq/OpenAI-compatible client
LLM_MAX_RETRIES=6                     # 429/5xx/timeouts (Groq and Gemini); waits follow the provider's retry-after header
LLM_MIN_INTERVAL=0                    # seconds between two requests; set e.g. 2 if a free tier answers HTTP 429 often
LLM_MAX_OUTPUT_TOKENS=8192            # reasoning models (gpt-oss) spend output tokens on reasoning first; raise if finish_reason=length
LLM_REASONING_EFFORT=                 # gpt-oss on Groq: low | medium | high (empty = provider default); --reasoning-effort overrides
# LLM_OFFLINE_FALLBACK is NOT implemented (no code reads it). A failed LLM call is recorded as a failed episode with an `error` column.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash         # check the exact id: python preflight_llm.py --planner gemini --list-models (configs/pricing.json has its price)
GEMINI_THINKING_BUDGET=               # optional, thinking tokens for Gemini 2.5 models (empty = model default)
# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b        # also openai/gpt-oss-20b and Kimi-K2 (moonshotai/kimi-k2-instruct-0905; check with --list-models)
# --- Optional providers (check the model name before first use) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Webots (only if the installer's default folder was changed) ---
# WEBOTS_HOME=C:\Program Files\Webots
