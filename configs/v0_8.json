{
  "_comment": "v0.8 protocol. Recovery parameters are fixed a priori (extra_probes=2, tau_action=0.0); nothing is tuned on test seeds. tau for the risk verifier is the v0.7 dev-selected value, not re-tuned. OracleBackend: harness-level evidence, not LLM evidence.",
  "families": ["motion", "goto", "clean_left", "remember_return"],
  "yaws": [0, 90, 180, 270],
  "dev_seeds": [0, 1, 2, 3, 4],
  "test_seeds": [100, 101, 102, 103, 104, 105, 106, 107, 108, 109],
  "conditions": [
    {"name": "static_n0.0", "noise": 0.0, "drift_at_call": null},
    {"name": "static_n0.1", "noise": 0.1, "drift_at_call": null},
    {"name": "drift_n0.1",  "noise": 0.1, "drift_at_call": 12}
  ],
  "slip": 0.0,
  "agent_config": "S5",
  "stop_confidence": 0.95, "max_task_probes": 3, "probe_len": 3,
  "hybrid_bay_probes": ["look", "turn90"], "hybrid_bay_budget": 2,
  "risk_tau": 0.5,
  "voi": {"c_fail": 6.0, "c_len": 0.5, "c_abstain": 30.0, "c_travel": 1.0, "c_risk": 20.0, "c_replan": 1.0, "min_net": 0.0, "lookahead": 3},
  "recovery": {"extra_probes": 2, "tau_action": 0.0, "max_entries_per_phase": 4, "max_guarded_repairs": 12},
  "tau_action_sensitivity_dev": [0.0, 0.05, 0.2, 0.5],
  "bootstrap_B": 4000,
  "primary_comparisons": [
    ["hybrid_robust+recovery", "hybrid_robust"],
    ["hybrid_robust_voi+recovery", "hybrid_robust_voi"],
    ["hybrid_robust+recovery", "hybrid_old"],
    ["hybrid_robust+monitor", "hybrid_robust"]
  ],
  "primary_metrics": ["success", "collisions", "aborted", "llm_calls", "env_tool_calls"]
}
