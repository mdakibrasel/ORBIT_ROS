{
  "_comment": "v0.8.1 protocol: the v0.8.0 arms plus belief-integrity arms (orbit_ros/integrity.py), on FRESH held-out seeds 200-209. Recovery parameters are the v0.8.0 values and the integrity parameters (eps_history) were fixed before any run on seeds 200-209; nothing is tuned on test seeds. tau for the risk verifier is the v0.7 dev-selected value. OracleBackend: harness-level evidence, not LLM evidence.",
  "protocol_note": "The integrity fixes and this configuration were written after inspecting the v0.7 test results (seeds 100-109) and the v0.8.0 quick run (seeds 100-102); held-out seeds 200-209 were not run before the final run and no unit test uses them. drift_n0.0 is a stress condition added in v0.8.1 (hard identifier updates + a change of move gain).",
  "families": ["motion", "goto", "clean_left", "remember_return"],
  "yaws": [0, 90, 180, 270],
  "dev_seeds": [0, 1, 2, 3, 4],
  "test_seeds": [200, 201, 202, 203, 204, 205, 206, 207, 208, 209],
  "conditions": [
    {"name": "static_n0.0", "noise": 0.0, "drift_at_call": null},
    {"name": "static_n0.1", "noise": 0.1, "drift_at_call": null},
    {"name": "drift_n0.1",  "noise": 0.1, "drift_at_call": 12},
    {"name": "drift_n0.0",  "noise": 0.0, "drift_at_call": 12}
  ],
  "slip": 0.0,
  "agent_config": "S5",
  "stop_confidence": 0.95, "max_task_probes": 3, "probe_len": 3,
  "hybrid_bay_probes": ["look", "turn90"], "hybrid_bay_budget": 2,
  "risk_tau": 0.5,
  "voi": {"c_fail": 6.0, "c_len": 0.5, "c_abstain": 30.0, "c_travel": 1.0, "c_risk": 20.0, "c_replan": 1.0, "min_net": 0.0, "lookahead": 3},
  "recovery": {"extra_probes": 2, "tau_action": 0.0, "max_entries_per_phase": 4, "max_guarded_repairs": 12},
  "integrity": {"censor_failed_probes": true, "no_collapse": true, "fail_closed": true, "eps_history": 0.01},
  "arms": [
    {"arm": "hybrid_old",                            "kind": "old"},
    {"arm": "hybrid_old+integrity",                  "kind": "old",    "integrity": true},
    {"arm": "hybrid_robust",                         "kind": "robust", "recovery": "off"},
    {"arm": "hybrid_robust+integrity",               "kind": "robust", "recovery": "off",          "integrity": true},
    {"arm": "hybrid_robust+monitor",                 "kind": "robust", "recovery": "monitor"},
    {"arm": "hybrid_robust+monitor+integrity",       "kind": "robust", "recovery": "monitor",      "integrity": true},
    {"arm": "hybrid_robust+recovery",                "kind": "robust", "recovery": "full"},
    {"arm": "hybrid_robust+recovery+integrity",      "kind": "robust", "recovery": "full",         "integrity": true},
    {"arm": "hybrid_robust+rec_reprobe_only",        "kind": "robust", "recovery": "reprobe_only"},
    {"arm": "hybrid_robust+rec_guarded_only",        "kind": "robust", "recovery": "guarded_only"},
    {"arm": "hybrid_robust_voi",                     "kind": "voi",    "recovery": "off"},
    {"arm": "hybrid_robust_voi+recovery",            "kind": "voi",    "recovery": "full"},
    {"arm": "hybrid_robust_voi+recovery+integrity",  "kind": "voi",    "recovery": "full",         "integrity": true},
    {"arm": "hybrid_risk",                           "kind": "risk",   "recovery": "off"},
    {"arm": "hybrid_risk+recovery",                  "kind": "risk",   "recovery": "full"},
    {"arm": "hybrid_risk+recovery+integrity",        "kind": "risk",   "recovery": "full",         "integrity": true}
  ],
  "sensitivity_arm": "hybrid_robust+recovery+integrity",
  "tau_action_sensitivity_dev": [0.0, 0.05, 0.2, 0.5],
  "bootstrap_B": 4000,
  "primary_comparisons": [
    ["hybrid_old+integrity", "hybrid_old"],
    ["hybrid_robust+integrity", "hybrid_robust"],
    ["hybrid_robust+recovery+integrity", "hybrid_robust+recovery"],
    ["hybrid_robust+monitor+integrity", "hybrid_robust+integrity"],
    ["hybrid_robust+recovery", "hybrid_robust"],
    ["hybrid_robust_voi+recovery", "hybrid_robust_voi"],
    ["hybrid_robust+recovery", "hybrid_old"],
    ["hybrid_robust+recovery+integrity", "hybrid_old+integrity"]
  ],
  "primary_metrics": ["success", "collisions", "abstained", "llm_calls", "env_tool_calls"]
}
