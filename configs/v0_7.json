{
  "_comment": "v0.7 protocol. tau is tuned on dev seeds ONLY; test seeds are never used for tuning. OracleBackend: harness-level evidence, not LLM evidence.",
  "families": ["motion", "goto", "clean_left", "remember_return"],
  "yaws": [0, 90, 180, 270],
  "dev_seeds": [0, 1, 2, 3, 4],
  "test_seeds": [100, 101, 102, 103, 104, 105, 106, 107, 108, 109],
  "noise_levels": [0.0, 0.1],
  "slip": 0.0,
  "agent_config": "S5",
  "stop_confidence": 0.95,
  "max_task_probes": 3,
  "probe_len": 3,
  "hybrid_bay_probes": ["look", "turn90"],
  "hybrid_bay_budget": 2,
  "min_weight_grid": [0.001, 0.005, 0.01, 0.02, 0.05, 0.1, 0.2],
  "tau_grid": [0.0, 0.02, 0.05, 0.1, 0.2, 0.3, 0.5],
  "selection_noise": 0.1,
  "selection_rule": "largest dev success among tau values whose dev episodes-with-collision rate <= that of hybrid_old + 0.01",
  "voi": {"c_fail": 6.0, "c_len": 0.5, "c_abstain": 30.0, "c_travel": 1.0, "c_risk": 20.0, "c_replan": 1.0, "min_net": 0.0, "lookahead": 3},
  "voi_sensitivity": {"c_abstain": [10.0, 30.0, 100.0], "lookahead": [1, 3]},
  "bootstrap_B": 4000,
  "primary_comparisons": [["hybrid_robust_voi", "hybrid_robust"], ["hybrid_robust_voi", "bay_old"], ["hybrid_risk_voi", "hybrid_risk"]],
  "primary_metrics": ["success", "collisions", "total_travel", "llm_calls", "aborted"]
}
